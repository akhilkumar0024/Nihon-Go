# ==============================================================================
# VocabVoice (.gitignore)
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor & IDE directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Environment & Secrets (CRITICAL)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Production Build Outputs
dist/
dist-ssr/
build/
out/
.output/

# Vite & Bundler Caches
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.cache/
.parcel-cache/
*.tsbuildinfo

# Vercel Deployment Cache
.vercel/

# Logs & Diagnostics
logs/
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.seed
*.pid.lock

# Test & Coverage Outputs
coverage/
*.lcov
.nyc_output/
playwright-report/
blob-report/
test-results/

# Temporary, scratch & agent directories
scratch/
.temp/
.turbo/
